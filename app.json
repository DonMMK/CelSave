{
  "expo": {
    "name": "CelSave",
    "slug": "celsave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.celsave.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "network-authentication"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router", 
      "expo-font", 
      "expo-web-browser",
      "./plugins/withNetworkExtensionEntitlements.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
